# Pi ships to Linux — these MUST stay LF or bash/systemd choke on a Windows-checkout CR. (deep-analysis P1 gate: crlf_clean)
*.sh            text eol=lf
*.service       text eol=lf
*.rules         text eol=lf
deploy/pi/*     text eol=lf
*.conf          text eol=lf
*.py            text eol=lf

# Windows-side bench tools that happen to live in deploy/pi/ — batch files with LF endings break `goto`/labels.
deploy/pi/*.cmd text eol=crlf
deploy/pi/*.ps1 text eol=crlf
