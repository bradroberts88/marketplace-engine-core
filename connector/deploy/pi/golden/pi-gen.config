# pi-gen config for the AutoPost golden image. Sourced by pi-gen's build. arm64, Bookworm/Trixie Lite base.
IMG_NAME="autopost-golden"
RELEASE="bookworm"
ARCH="arm64"
# Lite base (no desktop) + our stage. We stop after stage2 (minimal Lite) then add stage-autopost.
STAGE_LIST="stage0 stage1 stage2 stage-autopost"
# Headless: no default 'pi' user prompt; the connector runs as the 'autopost' system user (created in our stage).
DISABLE_FIRST_BOOT_USER_RENAME=1
TARGET_HOSTNAME="autopost-pi"
LOCALE_DEFAULT="en_US.UTF-8"
KEYBOARD_KEYMAP="us"
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT="Etc/UTC"
# Keep the boot partition FAT so the flasher can inject autopost-claim.env + firstrun.sh (WiFi) exactly as the
# SD-card flasher does today. WPA/claim are injected per-dealership at flash time, NOT baked into the image.
ENABLE_SSH=0
