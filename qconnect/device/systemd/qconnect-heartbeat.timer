[Unit]
Description=QConnect heartbeat every 5 minutes

[Timer]
# 45s, not 2 minutes: the first beat should land as soon as the box has any
# internet, not long after setup has finished a 15-minute hotspot window.
OnBootSec=45s
OnUnitActiveSec=5min
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
